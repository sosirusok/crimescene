# Long random secret used only to encrypt customer contact numbers at rest
PII_ENCRYPTION_KEY=replace-with-a-long-random-secret

# The admin site uses its password-key flow and a signed server session.
# No administrator email account or social-login variables are required.

# NICEPAY merchant credentials (store as deployment secrets; never expose the secret key in client code)
NICEPAY_CLIENT_ID=
NICEPAY_SECRET_KEY=
NICEPAY_ENVIRONMENT=sandbox

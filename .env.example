# Comma-separated administrator emails allowed to open /admin
ADMIN_EMAILS=owner@example.com

# Optional authentication entry points used by the server-rendered admin console
AUTH_SIGN_IN_PATH=
AUTH_SIGN_OUT_PATH=

# Long random secret used only to encrypt customer contact numbers at rest
PII_ENCRYPTION_KEY=replace-with-a-long-random-secret

# KISPG values must come from the merchant technical package
KIS_MID=
KIS_API_KEY=
KIS_PAY_REQUEST_URL=
KIS_CALLBACK_SECRET=
